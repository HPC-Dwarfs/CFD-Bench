#==============================================================================
#   Flow past a sphere, small enough to record under every solver in seconds.
#
#   The name is "canal" so that the setup-specific inflow applies; the geometry
#   is what makes this different from the obstacle-free canal baseline. The
#   sphere is resolved by about twelve cells across, enough for the multigrid
#   hierarchy to still see it two levels down.
#==============================================================================

name canal

bcLeft    3
bcRight   3
bcBottom  1
bcTop     1
bcFront   1
bcBack    1

gx     0.0
gy     0.0
gz     0.0

re            100.0

u_init        1.0
v_init        0.0
w_init        0.0
p_init        0.0

xlength       8.0
ylength       4.0
zlength       4.0
imax          48
jmax          24
kmax          24

te       0.3
dt       0.02
tau      0.5

levels        3
presmooth     5
postsmooth    5

itermax       50000
eps           0.0001
omg           1.8
gamma         0.9

geometryFile  sphere:2.0,2.0,2.0,0.5
