#==============================================================================
#   dcavity, reduced for baseline recording.
#
#   Derived from ../flow/dcavity.par. The grid is quartered in each direction and
#   the final time shortened so that recording all three solvers takes seconds.
#   Everything that decides behaviour -- boundary conditions, Reynolds number,
#   omega, eps -- is unchanged, so a regression in any of them still shows up.
#
#   itermax is large enough for red-black SOR to actually reach eps on this
#   grid. The shipped setups used to specify a budget that could not, which went
#   unnoticed because the convergence test always passed after two iterations.
#==============================================================================

name dcavity

bcTop      1
bcBottom   1
bcLeft     1
bcRight    1
bcFront    1
bcBack     1

gx     0.0
gy     0.0
gz     0.0

re     1000.0

u_init 0.0
v_init 0.0
w_init 0.0
p_init 0.0

xlength    1.0
ylength    1.0
zlength    1.0
imax       32
jmax       32
kmax       32

te         0.5
dt         0.02
tau        0.5

levels        5
presmooth     5
postsmooth    5

itermax  20000
eps      0.001
omg      1.8
gamma    0.9
